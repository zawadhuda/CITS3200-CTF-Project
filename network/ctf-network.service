[Unit]
Description=CTF Docker network lab
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/network
# PASV_ADDRESS must be the docker host's player-visible IP (check
# `ip -4 addr` on the VM), otherwise passive FTP breaks for off-host players.
# Set it once via: systemctl edit ctf-network.service  →  [Service]
# Environment=PASV_ADDRESS=<vm-ip>   (then daemon-reload + restart)
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
