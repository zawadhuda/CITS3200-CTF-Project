[Unit]
Description=Detect player-visible IP for passive FTP
Wants=systemd-networkd-wait-online.service
After=systemd-networkd-wait-online.service
Before=ctf-network.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/ctf-pasv-detect.sh

[Install]
WantedBy=multi-user.target
