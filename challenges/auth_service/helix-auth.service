[Unit]
Description=Helix Auth Service
After=network.target

[Service]
User=authsvc
# Flag lives ONLY in the live service environment — never on disk, never in
# the player-reversible binary copy. See challenges/auth_service/README.md.
Environment=FLAG=helix{re_auth-service-backdoor}
ExecStart=/opt/helix/auth_service --serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
