[Unit]
Description=Helix Auth Service
After=network.target

[Service]
User=authsvc
# No flag here by design: a grant yields a shell plus a nudge, and the
# chain's flag waits at real root. See challenges/auth_service/README.md.
ExecStart=/opt/helix/auth_service --serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
